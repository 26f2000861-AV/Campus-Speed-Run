# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security — keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.5-flash-lite (gemini-2.5-flash is no longer served to new keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Admin & demo ---
# Optional. Exact passcode for /admin (issuing staff registration codes) when no
# ADMINISTRATIVE account exists yet. Use a long random value.
ADMIN_PASSCODE=change-me-to-a-long-random-string
# Optional. "true" lets every staff role use the "Simulate +3 Days" button
# (otherwise ADMINISTRATIVE only). Turn on for live demos.
# DEMO_TIME_JUMP=true
